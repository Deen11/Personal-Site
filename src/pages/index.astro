---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, experience, education } from '../site';
import { hasResume } from '../resume';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const more = projects.filter((p) => !p.data.featured);
const degree = education[0];
const tags = ['LangGraph', 'LLM tool calling', 'Agent evals', 'Amazon Bedrock', 'FastAPI', 'React', 'TypeScript', 'Python', 'C++20', 'ECS', 'Lambda', 'Terraform'];
---

<Base hud>
  <!-- Each section names the shape the swarm forms while it is on screen -->
  <section class="sec hero" id="home" data-form="DEEN">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-title">
          <p class="mono muted">{site.name} · Software engineer · {site.location}</p>
          <h1>I build AI agents <span>and the systems around them.</span></h1>
        </div>
        <div class="hero-side">
          <p class="lede">
            Tool calling, evaluations and AWS deployments, on a foundation of <b>real-time simulation in C++</b>.
            Final-year CS at SIT and DigiPen, open to software and AI engineer roles from 2027.
          </p>
          <div class="actions">
            <a class="button primary" href="#work">See the work</a>
            <a class="button" href="#contact">Say hello</a>
          </div>
        </div>
      </div>
      <div class="hint mono"><span>Scroll to re-form the swarm <span class="arrow">↓</span></span><span>Move through it · click to scatter</span></div>
    </div>
  </section>

  <section class="sec" id="about" data-form="flock">
    <div class="container">
      <div class="text">
        <p class="kicker mono">About <span class="f">swarm → free flock</span></p>
        <h2 class="display">Lots of small parts. <em>One system</em> that behaves.</h2>
        <p class="lede">
          Every agent on this page follows three local rules, and together they move as one flock. That's the kind of
          problem I like. At GovTech I own an AI review platform end to end, from the React front end to the Bedrock
          assistant and the deployment pipeline. At DigiPen I led nine programmers building a C++ 3D engine.
        </p>
        <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sec" id="work" data-form="</>">
    <div class="container">
      <div class="text wide">
        <p class="kicker mono">Selected work <span class="f">swarm → &lt;/&gt;</span></p>
        <h2 class="display">Things I've <em>built</em></h2>
        <div class="cards">
          {featured.map((project) => <ProjectCard project={project} />)}
        </div>
        {
          more.length > 0 && (
            <p class="more muted">
              Also built:{' '}
              {more.map((p, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/projects/${p.id}/`}>{p.data.title}</a>
                </>
              ))}
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="sec" id="experience" data-form="2027">
    <div class="container">
      <div class="text wide">
        <p class="kicker mono">Experience <span class="f">swarm → 2027</span></p>
        <h2 class="display">Open to roles from <em>2027</em></h2>
        <ol class="jobs">
          {
            experience.map((job) => (
              <li class="job">
                <span class="mono">{job.dates}</span>
                <div>
                  <h3>
                    {job.role} <span>· {job.org}</span>
                  </h3>
                  <p>{job.summary}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="muted degree">{degree.degree} · {degree.school} · {degree.dates}</p>
      </div>
    </div>
  </section>

  <section class="sec" id="contact" data-form="HI!">
    <div class="container">
      <div class="text">
        <p class="kicker mono">Contact <span class="f">swarm → HI!</span></p>
        <h2 class="display">Let's build something that <em>behaves</em>.</h2>
        <p class="lede">I'm looking for software and AI engineer roles starting in 2027. Email is the fastest way to reach me.</p>
        <p class="mail">{site.email}</p>
        <div class="actions">
          <a class="button primary" href={`mailto:${site.email}`}>Email me</a>
          <button class="button" type="button" id="copy">Copy email</button>
          <a class="button" href={site.linkedin}>LinkedIn</a>
          <a class="button" href={site.github}>GitHub</a>
          {hasResume && <a class="button" href="/resume.pdf">Resume (PDF)</a>}
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { site } from '../site';

  const copy = document.getElementById('copy');
  copy?.addEventListener('click', () => {
    const done = (text: string) => {
      copy.textContent = text;
      setTimeout(() => (copy.textContent = 'Copy email'), 1800);
    };
    navigator.clipboard.writeText(site.email).then(
      () => done('Copied'),
      () => done('Select it above'),
    );
  });
</script>

<style>
  .sec {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 140px;
  }

  .sec > .container {
    flex: 1;
  }

  .text {
    max-width: 540px;
    display: grid;
    gap: 24px;
  }

  .text.wide {
    max-width: 580px;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
  }

  .kicker .f {
    color: var(--accent);
    border: 1px solid rgba(255, 181, 71, 0.35);
    padding: 3px 8px;
    border-radius: 6px;
  }

  .lede {
    color: var(--muted);
    font-size: 19px;
    max-width: 34em;
  }

  .lede b {
    color: var(--text);
    font-weight: 600;
  }

  /* Hero: the swarm spells the name, the copy sits under it */
  .hero {
    align-items: flex-end;
    padding-bottom: 72px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 48px;
    align-items: end;
  }

  .hero-title,
  .hero-side {
    display: grid;
    gap: 18px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    font-size: clamp(32px, 3.6vw, 54px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  h1 span {
    color: var(--muted);
    font-weight: 500;
  }

  .hint {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 54px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--muted);
  }

  .arrow {
    display: inline-block;
    animation: nudge 1.8s ease-in-out infinite;
  }

  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  .cards {
    display: grid;
    gap: 12px;
  }

  .more {
    font-size: 15.5px;
  }

  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--border);
  }

  .job {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 18px;
    padding-block: 16px;
    border-bottom: 1px solid var(--border);
  }

  .job .mono {
    padding-top: 4px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .job h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 105%;
    font-size: 19px;
    line-height: 1.25;
  }

  .job h3 span {
    font-weight: 400;
    color: var(--muted);
  }

  .job p {
    color: var(--muted);
    font-size: 15.5px;
    margin-top: 3px;
  }

  .degree {
    font-size: 15.5px;
  }

  .mail {
    font-family: var(--font-mono);
    font-size: 17px;
    user-select: all;
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .sec {
      padding-block: 120px 100px;
      align-items: flex-start;
    }

    /* On phones the swarm forms its shape at the top and the text scrolls up under it */
    .sec:not(.hero) {
      padding-top: 46vh;
    }

    .hero {
      align-items: flex-start;
      padding-top: 38svh;
      padding-bottom: 96px;
    }

    .hint {
      display: none;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }

    .job {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
