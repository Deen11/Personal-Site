---
import Base from '../layouts/Base.astro';
import LifeHero from '../components/LifeHero.astro';
import Ticker from '../components/Ticker.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getProjects, pad } from '../projects';
import { site } from '../site';

const featured = (await getProjects()).filter((p) => p.data.featured);
const stats = [
  { value: '8×', label: 'Faster audit turnaround' },
  { value: '2nd', label: 'NUS-ISS agents hackathon' },
  { value: '9', label: 'Engineers led on a C++ engine' },
  { value: '3', label: 'AWS environments shipped' },
];
---

<Base bareHeader>
  <LifeHero />
  <Ticker />

  <div class="wrap">
    <section class="stats" aria-label="Highlights">
      {
        stats.map((s) => (
          <div class="stat">
            <span class="value">{s.value}</span>
            <span class="eyebrow label">{s.label}</span>
          </div>
        ))
      }
    </section>

    <section class="work" aria-labelledby="work-title">
      <div class="head">
        <h2 id="work-title" class="eyebrow">Selected work</h2>
        <a href="/work" class="mono">All projects →</a>
      </div>
      <div>
        {
          featured.map((p, i) => (
            <ProjectRow
              href={`/work/${p.id}`}
              number={pad(i + 1)}
              title={p.data.title}
              summary={p.data.summary}
              stack={p.data.stack}
              size="lg"
            />
          ))
        }
      </div>
    </section>

    <section class="contact" aria-labelledby="contact-title">
      <h2 id="contact-title">Let's build something <span class="accent">useful.</span></h2>
      <div class="links mono">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.linkedin} class="quiet">linkedin.com/in/deenaleusuf</a>
        <a href={site.github} class="quiet">github.com/Deen11</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .stat {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-left: 1px solid var(--line);
  }
  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .value {
    font-size: 44px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .label {
    font-size: 12px;
  }
  .work {
    padding: 88px 0 72px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 24px;
  }
  .head h2 {
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  .contact {
    padding-bottom: 72px;
    display: flex;
    justify-content: space-between;
    gap: 40px;
    align-items: flex-end;
  }
  .contact h2 {
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14px;
    flex-shrink: 0;
  }
  .quiet {
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .work {
      padding: 64px 0 56px;
    }
    .contact {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
