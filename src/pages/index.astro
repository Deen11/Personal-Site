---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, experience, skills, education, awards } from '../site';
import { hasResume } from '../resume';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const more = projects.filter((p) => !p.data.featured);
---

<Base>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{site.location} · Open to 2027 roles</p>
      <h1>{site.name}</h1>
      <p class="headline">Software engineer building AI agents and the systems around them.</p>
      <p class="pitch">
        I build LLM applications end to end, from tool-calling agents and evaluations to secure deployment on AWS,
        with a foundation in C++ systems. Final-year Computer Science student at SIT and DigiPen, open to software
        engineer and AI engineer roles from 2027.
      </p>
      <div class="actions">
        <a class="button primary" href="#projects">View projects</a>
        {hasResume && <a class="button" href="/resume.pdf">Download resume</a>}
        <a class="button" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <h2>About</h2>
      <p>
        I'm a software engineer in Singapore, currently interning at GovTech, where I own an AI-assisted review
        platform on AWS from the React front end to the Bedrock assistant and the deployment pipeline. I like work
        where a model is only one part of the system, and the rest is validation, tools, evaluation, and careful
        rollout.
      </p>
      <p>
        Before software I spent two years as an Emergency Medical Technician with the Singapore Civil Defence Force,
        which taught me to stay calm when things break. At DigiPen I led a nine-programmer team building a custom C++
        3D engine, and outside work I build and test agents at hackathons. I graduate in 2027.
      </p>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <h2>Projects</h2>
      <div class="grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
      {
        more.length > 0 && (
          <>
            <h3 class="sub">Also built</h3>
            <ul class="more">
              {more.map((p) => (
                <li>
                  <a href={`/projects/${p.id}/`}>{p.data.title}</a>
                  <span class="muted"> · {p.data.summary}</span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <h2>Experience</h2>
      <ol class="timeline">
        {
          experience.map((job) => (
            <li>
              <p class="dates">{job.dates}</p>
              <h3>
                {job.role} <span class="org">· {job.org}</span>
              </h3>
              <p class="muted">{job.summary}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="skills">
    <div class="container">
      <h2>Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.area}</dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>

      <h2 class="spaced">Education</h2>
      <ul class="plain">
        {
          education.map((e) => (
            <li>
              <h3>{e.degree}</h3>
              <p class="muted">
                {e.school} · {e.dates}
              </p>
              {e.note && <p class="muted note">{e.note}</p>}
            </li>
          ))
        }
      </ul>

      <h2 class="spaced">Awards</h2>
      <ul>
        {awards.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <h2>Contact</h2>
      <p>I'm looking for software engineer and AI engineer roles starting in 2027. The fastest way to reach me is email.</p>
      <div class="actions">
        <a class="button primary" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="button" href={site.linkedin}>LinkedIn</a>
        <a class="button" href={site.github}>GitHub</a>
        {hasResume && <a class="button" href="/resume.pdf">Resume (PDF)</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 72px 0 56px;
  }

  h1 {
    font-size: clamp(2.2rem, 7vw, 3.2rem);
    margin: 0 0 0.75rem;
  }

  .headline {
    font-size: clamp(1.2rem, 3.6vw, 1.45rem);
    font-weight: 600;
    margin: 0 0 1rem;
  }

  .pitch {
    color: var(--muted);
    margin: 0 0 1.75rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 16px;
  }

  .sub {
    margin: 2rem 0 0.75rem;
  }

  .more {
    padding-left: 1.2rem;
    margin: 0;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 20px;
    border-left: 2px solid var(--border);
  }

  .timeline li {
    position: relative;
    padding-bottom: 28px;
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -27px;
    top: 8px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .timeline p {
    margin: 0.25rem 0 0;
  }

  .dates {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .org {
    font-weight: 400;
    color: var(--muted);
  }

  .skills {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .skills dt {
    font-weight: 600;
  }

  .skills dd {
    margin: 0;
    color: var(--muted);
  }

  .spaced {
    margin-top: 2.5rem;
  }

  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }

  .plain p {
    margin: 0.2rem 0 0;
  }

  .note {
    font-size: 0.92rem;
  }
</style>
