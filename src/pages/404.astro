---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="container missing">
    <h1>Page not found</h1>
    <p class="muted">That page doesn't exist.</p>
    <a class="button primary" href="/">Back to the homepage</a>
  </div>
</Base>

<style>
  .missing {
    padding: 96px 20px;
  }
</style>
