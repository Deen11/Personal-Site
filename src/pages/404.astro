---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="container missing">
    <p class="eyebrow">404</p>
    <h1 class="display">This page flew off with the flock.</h1>
    <p class="muted">That page doesn't exist.</p>
    <div class="actions"><a class="button primary" href="/">Back to the homepage</a></div>
  </div>
</Base>

<style>
  .missing {
    min-height: 80vh;
    display: grid;
    align-content: center;
    gap: 18px;
    padding-block: 140px 60px;
  }
</style>
