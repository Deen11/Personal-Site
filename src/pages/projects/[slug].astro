---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, stack, date, role, award, links, video, note } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary}>
  <article class="container project">
    <a class="back mono" href="/#work">← All work</a>
    <p class="eyebrow">{[date, role].filter(Boolean).join(' · ')}</p>
    <h1>{title}</h1>
    {award && <p class="award">{award}</p>}
    <p class="lead">{summary}</p>
    <ul class="tags">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
    {
      links.length > 0 && (
        <p class="links">
          {links.map((l) => (
            <a class="button" href={l.href}>
              {l.label} ↗
            </a>
          ))}
        </p>
      )
    }
    {
      video && (
        <video class="video" src={video} controls preload="metadata" playsinline>
          <track kind="captions" />
        </video>
      )
    }
    <div class="body">
      <Content />
    </div>
    {note && <p class="note muted">{note}</p>}
  </article>
</Base>

<style>
  .project {
    max-width: 820px;
    padding-top: calc(env(safe-area-inset-top, 0px) + 130px);
    padding-bottom: 96px;
  }

  .back {
    display: inline-block;
    margin-bottom: 28px;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--text);
  }

  .eyebrow {
    margin-bottom: 14px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
  }

  .award {
    margin: 0 0 1rem;
  }

  .lead {
    font-size: 21px;
    line-height: 1.45;
    margin: 0 0 22px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 1.25rem 0 0;
  }

  .video {
    width: 100%;
    margin-top: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #000;
  }

  .body {
    margin-top: 40px;
    padding: 28px clamp(20px, 4vw, 36px);
    background: var(--panel);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .body :global(p) {
    color: var(--muted);
  }

  .body :global(p + p) {
    margin-top: 1em;
  }

  .body :global(h2) {
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 110%;
    font-size: 24px;
    margin: 32px 0 10px;
  }

  .body :global(h2:first-child) {
    margin-top: 0;
  }

  .body :global(ul) {
    color: var(--muted);
    padding-left: 1.2em;
    margin: 0;
  }

  .body :global(li) {
    margin-bottom: 0.5rem;
  }

  .body :global(strong) {
    color: var(--text);
  }

  .note {
    margin-top: 2rem;
    font-size: 0.92rem;
    font-style: italic;
  }
</style>
