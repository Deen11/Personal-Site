---
interface Props {
  // Show the live readout of agent count, formation and frame rate
  hud?: boolean;
}

const { hud = false } = Astro.props;
---

<canvas id="swarm" aria-hidden="true"></canvas>
{
  hud && (
    <div class="hud mono" aria-hidden="true">
      <span>
        agents <b id="hud-n">0</b>
      </span>
      <b id="hud-f">DEEN</b>
      <span class="bar" id="hud-t">
        <i />
      </span>
      <span class="fps">
        <b id="hud-fps">60</b> fps
      </span>
    </div>
  )
}

<script>
  import { startSwarm } from '../scripts/swarm';

  const canvas = document.getElementById('swarm');
  if (canvas instanceof HTMLCanvasElement) startSwarm(canvas);
</script>

<style>
  #swarm {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    display: block;
  }

  .hud {
    position: fixed;
    z-index: 6;
    right: max(28px, env(safe-area-inset-right, 0px));
    bottom: calc(env(safe-area-inset-bottom, 0px) + 22px);
    display: flex;
    gap: 18px;
    align-items: center;
    color: var(--muted);
    pointer-events: none;
    padding: 9px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(5, 6, 9, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-variant-numeric: tabular-nums;
  }

  .hud b {
    color: var(--text);
    font-weight: 500;
  }

  .bar {
    width: 64px;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
  }

  .bar i {
    display: block;
    height: 100%;
    width: calc(var(--t, 0) * 100%);
    background: var(--accent);
  }

  @media (max-width: 860px) {
    .hud {
      left: max(16px, env(safe-area-inset-left, 0px));
      right: auto;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
      gap: 12px;
    }

    .fps {
      display: none;
    }
  }
</style>
