---
interface Props {
  href: string;
  number: string;
  title: string;
  summary: string;
  stack: string;
  size?: 'lg' | 'md';
}
const { href, number, title, summary, stack, size = 'md' } = Astro.props;
---

<a href={href} class:list={['row', size]}>
  <span class="num mono">{number}</span>
  <span class="main">
    <span class="title">{title}</span>
    <span class="summary">{summary}</span>
  </span>
  <span class="stack mono">{stack}</span>
  <svg class="go" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 280px 32px;
    gap: 24px;
    align-items: center;
    padding: 34px 0;
    border-top: 1px solid var(--line);
    color: var(--text);
    transition:
      background-color 0.35s,
      padding 0.35s;
  }
  .row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .row:hover {
    background: var(--surface);
    padding-left: 16px;
    padding-right: 16px;
    color: var(--text);
  }
  .num {
    color: var(--accent);
  }
  .main {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .title {
    font-size: 38px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .lg .title {
    font-size: 44px;
    letter-spacing: -0.03em;
  }
  .summary {
    font-size: 15px;
    color: var(--muted);
  }
  .stack {
    font-size: 12px;
    color: var(--muted);
  }
  .go {
    color: var(--accent);
    transition: translate 0.35s;
  }
  .row:hover .go {
    translate: 6px 0;
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: 40px minmax(0, 1fr) 24px;
      gap: 16px;
      padding: 26px 0;
    }
    .stack {
      grid-column: 2;
      grid-row: 2;
    }
    .go {
      grid-column: 3;
      grid-row: 1;
    }
    .title,
    .lg .title {
      font-size: clamp(26px, 6vw, 36px);
    }
  }
</style>
