---
import { hasResume } from '../resume';

const links = [
  { id: 'work', label: 'Work' },
  { id: 'experience', label: 'Experience' },
  { id: 'contact', label: 'Contact' },
];
---

<header class="top">
  <a class="mark" href="/#home"><i></i>EUSUF.DEV</a>
  <nav aria-label="Main">
    {
      links.map((l) => (
        <a href={`/#${l.id}`} data-nav={l.id}>
          {l.label}
        </a>
      ))
    }
    {hasResume && <a href="/resume.pdf">Resume</a>}
  </nav>
</header>

<style>
  .top {
    position: fixed;
    z-index: 6;
    inset: 0 0 auto;
    padding: calc(env(safe-area-inset-top, 0px) + 18px) max(var(--gutter), env(safe-area-inset-right, 0px)) 28px
      max(var(--gutter), env(safe-area-inset-left, 0px));
    background: linear-gradient(var(--void) 35%, rgba(5, 6, 9, 0));
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    pointer-events: none;
  }

  .top > * {
    pointer-events: auto;
  }

  .mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: 16px;
    text-decoration: none;
    letter-spacing: 0.01em;
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .mark i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 14px var(--accent);
  }

  nav {
    display: flex;
    gap: 2px;
  }

  nav a {
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--muted);
    transition:
      color 0.2s,
      background 0.2s;
  }

  nav a:hover,
  nav a:global(.on) {
    color: var(--text);
    background: rgba(255, 255, 255, 0.07);
  }

  @media (max-width: 860px) {
    .top {
      padding-bottom: 20px;
    }

    .mark {
      font-size: 14px;
      gap: 8px;
    }

    nav a {
      padding: 6px 8px;
      font-size: 13.5px;
    }
  }
</style>
