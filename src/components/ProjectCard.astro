---
import type { CollectionEntry } from 'astro:content';
import CardArtifact from './CardArtifact.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, stack, date, award, links } = project.data;
---

<article class="card panel">
  <p class="mono muted">{date}</p>
  <h3><a href={`/projects/${project.id}/`}>{title}</a></h3>
  {award && <p class="award">{award}</p>}
  <p class="summary">{summary}</p>
  <p class="stack">{stack.join(' · ')}</p>
  {
    links.length > 0 && (
      <p class="links">
        {links.map((l) => (
          <a href={l.href}>{l.label} →</a>
        ))}
      </p>
    )
  }
  <CardArtifact id={project.id} />
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 24px;
    transition: border-color 150ms var(--ease);
  }

  .card:hover {
    border-color: rgba(255, 255, 255, 0.24);
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-stretch: 112%;
    font-size: 28px;
    line-height: 1.1;
  }

  h3 a {
    text-decoration: none;
  }

  /* The whole card opens the project page */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .summary {
    color: var(--muted);
    font-size: 16px;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* Outside links sit above the card-wide link */
  .links a {
    position: relative;
    z-index: 1;
    font-weight: 500;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
