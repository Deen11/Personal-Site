---
// A thin living strip between sections. Hovering seeds a few cells; it never needs attention.
---

<div class="divider" aria-hidden="true" data-life-divider>
  <canvas></canvas>
</div>

<style>
  .divider {
    height: 56px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { Life, seeded, reducedMotion, fitCanvas } from '../scripts/life';

  const CELL = 8;
  const ROWS = 7;
  const STEP_EVERY = 10;
  const reduce = reducedMotion();
  const rnd = seeded(5);

  type Strip = { el: HTMLElement; canvas: HTMLCanvasElement; ctx?: CanvasRenderingContext2D; width: number; life?: Life; visible: boolean };
  const strips: Strip[] = [];

  const draw = (s: Strip) => {
    if (!s.ctx || !s.life) return;
    const { ctx, width, life } = s;
    const height = ROWS * CELL;
    ctx.clearRect(0, 0, width, height);
    ctx.fillStyle = 'rgba(255,255,255,0.03)';
    ctx.fillRect(0, 0, width, 1);
    ctx.fillRect(0, height - 1, width, 1);
    const { grid, age, w } = life;
    for (let i = 0; i < grid.length; i++) {
      const a = grid[i] ? 0.7 : age[i] * 0.15;
      if (a <= 0) continue;
      ctx.fillStyle = `rgba(212,245,60,${a})`;
      ctx.fillRect((i % w) * CELL + 1, Math.floor(i / w) * CELL + 1, CELL - 2, CELL - 2);
    }
  };

  const fit = (s: Strip) => {
    const { ctx, width } = fitCanvas(s.canvas);
    s.ctx = ctx;
    s.width = width;
    const w = Math.ceil(width / CELL);
    if (!s.life) {
      s.life = new Life(w, ROWS);
      for (let i = 0; i < s.life.grid.length; i++) if (rnd() < 0.12) s.life.set(i % w, Math.floor(i / w));
    } else {
      s.life.resize(w, ROWS);
    }
    draw(s);
  };

  for (const el of document.querySelectorAll<HTMLElement>('[data-life-divider]')) {
    const s: Strip = { el, canvas: el.querySelector('canvas')!, width: 0, visible: false };
    strips.push(s);
    el.addEventListener('pointermove', (e) => {
      if (!s.life) return;
      const r = s.canvas.getBoundingClientRect();
      const x = Math.floor((e.clientX - r.left) / CELL);
      const y = Math.floor((e.clientY - r.top) / CELL);
      for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) if (rnd() < 0.4) s.life.set(x + dx, y + dy);
      if (reduce) draw(s);
    });
    new ResizeObserver(() => fit(s)).observe(el);
    new IntersectionObserver(([entry]) => (s.visible = entry.isIntersecting)).observe(el);
    fit(s);
  }

  let frame = 0;
  const tick = () => {
    frame++;
    for (const s of strips) {
      if (!s.visible || !s.life) continue;
      if (frame % STEP_EVERY === 0) {
        s.life.step();
        // A strip that dies out gets a small handful of cells somewhere along it
        if (s.life.pop < 12) {
          const cx = Math.floor(rnd() * s.life.w);
          for (let k = 0; k < 6; k++) s.life.set(cx + Math.floor(rnd() * 4), Math.floor(rnd() * ROWS));
        }
      }
      s.life.fade(0.05);
      draw(s);
    }
    requestAnimationFrame(tick);
  };
  if (!reduce && strips.length) requestAnimationFrame(tick);
</script>
